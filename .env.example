# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate once and keep: changing them logs admins out.
# openssl rand -base64 32   → one value per line
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Demo content: seed on an empty database, and wipe + reseed with SEED_RESET=true
SEED_ON_BOOT=true
SEED_RESET=false

# Where the seed reads ui-strings.json from (inside Docker: /shared)
SHARED_DIR=../shared

# Browser origins allowed to call the API directly (nginx proxies same-origin,
# so this only matters when the frontend talks to Strapi across ports)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
